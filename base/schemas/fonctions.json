{
  "description": "Fonctions de la dépense, c'est-à-dire sa destination : classification COFOG (codes GF, regroupements notés avec « + »), ou missions et programmes du budget de l'État (norme LOLF, identifiants formés de leurs libellés).",
  "fields": [
    {"name": "id", "type": "string", "constraints": {"required": true, "pattern": "GF[0-9]{2,4}(\\+GF[0-9]{2,4})*|LOLF(\\.[A-Z0-9_]+){1,2}"}},
    {"name": "libelle", "type": "string", "constraints": {"required": true}},
    {"name": "norme_id", "type": "string", "constraints": {"required": true}},
    {"name": "parent_id", "type": "string"}
  ],
  "primaryKey": ["id"],
  "foreignKeys": [
    {"fields": ["norme_id"], "reference": {"resource": "normes", "fields": ["id"]}},
    {"fields": ["parent_id"], "reference": {"resource": "", "fields": ["id"]}}
  ]
}
