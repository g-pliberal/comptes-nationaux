{
  "description": "Ce qui est mesuré, défini dans une norme. Deux concepts de normes différentes ne se comparent qu'à travers une passerelle documentée.",
  "fields": [
    {"name": "id", "type": "string", "description": "Norme, point, code dans la norme.", "constraints": {"required": true, "pattern": "[A-Z0-9_]+\\.[A-Za-z0-9_]+"}},
    {"name": "libelle", "type": "string", "constraints": {"required": true}},
    {"name": "norme_id", "type": "string", "constraints": {"required": true}},
    {"name": "code_norme", "type": "string", "constraints": {"required": true}},
    {"name": "sens", "type": "string", "constraints": {"required": true, "enum": ["depense", "recette", "solde", "agregat"]}},
    {"name": "definition", "type": "string"}
  ],
  "primaryKey": ["id"],
  "foreignKeys": [
    {"fields": ["norme_id"], "reference": {"resource": "normes", "fields": ["id"]}}
  ]
}
